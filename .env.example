# =============================================================================
# Variáveis de ambiente — Finanças do Casal
# =============================================================================
# COMO USAR:
#   1. Copie este arquivo para .env.local  →  cp .env.example .env.local
#   2. Preencha com os valores do SEU projeto Supabase
#      (Dashboard → Project Settings → API Keys / Data API)
#   3. .env.local NUNCA vai para o git (o .gitignore protege)
#
# IMPORTANTE:
#   - Variáveis com prefixo NEXT_PUBLIC_ são embutidas no bundle do browser.
#     Isso é esperado e seguro para a chave "publishable": quem protege os dados
#     é o Row Level Security (RLS) do Postgres, não o segredo da chave.
#   - NUNCA coloque aqui a chave secreta (service_role / sb_secret_...).
#     Ela ignora o RLS e só deve existir em rotinas administrativas server-side.
# =============================================================================

# URL do projeto Supabase, no formato https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (publishable key) do projeto — pode aparecer no browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
